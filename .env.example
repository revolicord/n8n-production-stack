# ============================================================
# COPIA ESTE ARCHIVO A .env Y RELLENA TODOS LOS VALORES
# cp .env.example .env
#
# O ejecuta: bash scripts/setup.sh  (genera credenciales automáticamente)
#
# Generar claves manualmente:
#   N8N_ENCRYPTION_KEY:  openssl rand -hex 32
#   POSTGRES_PASSWORD:   openssl rand -base64 24 | tr -d '/+=' | head -c 24
#   REDIS_PASSWORD:      openssl rand -base64 24 | tr -d '/+=' | head -c 24
#   MINIO_ROOT_PASSWORD: openssl rand -base64 24 | tr -d '/+=' | head -c 24
# ============================================================

# ---- Dominios -----------------------------------------------
N8N_HOST=n8n.tudominio.com
MINIO_DOMAIN=minio.tudominio.com
MINIO_CONSOLE_DOMAIN=minio-console.tudominio.com

# ---- Red overlay de Traefik ---------------------------------
# Debe coincidir con la red donde está el servicio traefik
TRAEFIK_NETWORK=traefik-public

# ---- PostgreSQL ---------------------------------------------
POSTGRES_PASSWORD=CAMBIA_ESTO

# ---- Redis --------------------------------------------------
REDIS_PASSWORD=CAMBIA_ESTO

# ---- n8n ----------------------------------------------------
# DEBE SER IGUAL en main, webhook y los 3 workers
# Generada UNA VEZ — cambiarla después rompe todas las credenciales cifradas
N8N_ENCRYPTION_KEY=CAMBIA_ESTO_usa_openssl_rand_hex_32

# ---- MinIO --------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CAMBIA_ESTO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=CAMBIA_ESTO
MINIO_BUCKET_ASSETS=assets
MINIO_PUBLIC_URL=https://minio.tudominio.com

# ---- API DM Setter ------------------------------------------
API_HOST=api.tudominio.com

# Tokens (generar: openssl rand -hex 32 / -hex 64)
MC_WEBHOOK_TOKEN=CAMBIA_ESTO
N8N_CALLBACK_TOKEN=CAMBIA_ESTO
ADMIN_JWT_SECRET=CAMBIA_ESTO

# Imagen Docker de la API
API_IMAGE=dm-api:local

# ---- Dashboard analítico ------------------------------------
DASHBOARD_HOST=dashboard.tudominio.com
PANEL_PASSWORD=CAMBIA_ESTO
# Generar: openssl rand -hex 32
PANEL_JWT_SECRET=CAMBIA_ESTO_usa_openssl_rand_hex_32

# Imagen Docker del dashboard
DASHBOARD_IMAGE=dm-dashboard:local

# ---- GitHub backup de workflows n8n -------------------------
# PAT con permisos Contents: Read/Write
# Crear en: GitHub → Settings → Developer settings → Fine-grained tokens
GITHUB_TOKEN=CAMBIA_ESTO
GITHUB_OWNER=revolicord
GITHUB_REPO=n8n-production-stack
GITHUB_BRANCH=master
GITHUB_PATH=n8n-workflows

# ---- Motor de diálogo agent (ADR-0024/0025) -----------------
# API key de Anthropic. Requerida cuando engine='agent' en tenant.config.
# Crear en: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_TIMEOUT_MS=60000
# ---- Escalado a humano (Telegram) ---------------------------
# Bot de @BotFather. Si se deja vacío, las notificaciones se guardan
# en DB pero no se envían a Telegram.
TELEGRAM_BOT_TOKEN=
# Chat/grupo destino por defecto (override por tenant: tenant.config.telegram_chat_id)
TELEGRAM_DEFAULT_CHAT_ID=
# Secreto del webhook de callbacks (botones). Generar: openssl rand -hex 16
# Registrar una vez: bash scripts/telegram-set-webhook.sh
TELEGRAM_WEBHOOK_SECRET=
# Cada cuántas horas recordar por Telegram los leads aún pausados (0 = off)
PAUSE_REMINDER_HOURS=6
# Cada cuántos minutos corre el runner de follow-ups (0 = off). Migración del workflow n8n.
FOLLOWUP_INTERVAL_MINUTES=5

# ---- Observabilidad LangSmith (ADR-0025, motor agent) -------
# Traza técnica del grafo LangGraph. Opcional/provisional. La traza legible de
# negocio vive en api.agent_turn_traces (no depende de esto).
# Crear API key en: https://smith.langchain.com → Settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=dm-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
