{
  "name": "dm-api",
  "version": "0.0.1",
  "private": true,
  "description": "ManyChat → debounce API → n8n. Monorepo Sprint 0+",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r --parallel build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev:api": "pnpm --filter @dm-api/api dev:api",
    "dev:worker": "pnpm --filter @dm-api/api dev:worker",
    "db:generate": "pnpm --filter @dm-api/db db:generate",
    "db:migrate": "pnpm --filter @dm-api/db db:migrate",
    "db:studio": "pnpm --filter @dm-api/db db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "9.1.7",
    "typescript": "5.6.3"
  }
}
