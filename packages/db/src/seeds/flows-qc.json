[
  {
    "flow_id": "qc_cascade_a_b",
    "name": "Cascada A→B: audio + VSL tras señal positiva al hook",
    "description": "Disparado cuando el lead aprueba el hook (LLM emite ChangeStage A→B con cascade:true). Entrega el contenido core (audio pre-VSL + VSL). NO avanza de etapa: B es un estado de espera donde se aguarda la reacción a la VSL.",
    "trigger": { "type": "stage_transition", "from": "A", "to": "B" },
    "slots": [],
    "steps": [
      {
        "id": "s1",
        "type": "action",
        "action": "send_content",
        "config": {
          "slug_id": "audio_prevsl",
          "lookup_stage": "B"
        }
      },
      {
        "id": "s2",
        "type": "action",
        "action": "send_content",
        "config": {
          "slug_id": "vsl_resultados",
          "lookup_stage": "B"
        }
      }
    ]
  },
  {
    "flow_id": "qc_cascade_b_c",
    "name": "Cascada B→C: audio + link de Calendly",
    "trigger": { "type": "stage_transition", "from": "B", "to": "C" },
    "slots": [],
    "steps": [
      {
        "id": "s1",
        "type": "action",
        "action": "send_content",
        "config": {
          "slug_id": "audio_precalendly",
          "lookup_stage": "C"
        },
        "on_failure": "continue"
      },
      {
        "id": "s2",
        "type": "action",
        "action": "reply_text",
        "config": {
          "template": "{lead_in} {tenant.calendly_url}",
          "fallback": "Aquí tienes, elige el horario que te venga: {tenant.calendly_url}"
        }
      }
    ]
  },
  {
    "flow_id": "qc_cascade_c_d",
    "name": "Cascada C→D: video nurturing tras agendar",
    "description": "Disparado por el ChangeStage(C→D, cascade) que inyecta el webhook de Calendly. El LLM aporta el texto de confirmación con la hora. La cascada solo entrega el intro + link de video de nurturing (sin audio).",
    "trigger": { "type": "stage_transition", "from": "C", "to": "D" },
    "slots": [],
    "steps": [
      {
        "id": "s1",
        "type": "action",
        "action": "reply_text",
        "config": {
          "template": "🎥 Mientras llega el día, mira este video que preparé para ti:",
          "fallback": "Nos vemos en la llamada."
        }
      },
      {
        "id": "s2",
        "type": "action",
        "action": "reply_text",
        "config": {
          "template": "{tenant.nurturing_video_url}",
          "fallback": ""
        }
      }
    ]
  },
  {
    "flow_id": "qc_farewell_disqualified",
    "name": "Despedida al descalificar",
    "trigger": { "type": "stage_transition", "from": "*", "to": "disqualified" },
    "slots": [],
    "steps": [
      {
        "id": "s1",
        "type": "action",
        "action": "reply_text",
        "config": {
          "template": "{lead_in}",
          "fallback": "Vale, no es tu momento. Éxitos."
        }
      }
    ]
  }
]
