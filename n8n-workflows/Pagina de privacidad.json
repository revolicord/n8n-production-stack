        "jsCode": "const html = `<!DOCTYPE html><html><head><meta charset='UTF-8'><title>Privacy Policy - conexion_n8n</title></head><body style='font-family:Arial;max-width:800px;margin:40px auto;padding:20px;color:#333'><h1>Privacy Policy</h1><p><strong>Last updated: May 30, 2026</strong></p><p>This Privacy Policy describes how conexion_n8n handles your information when you use our application.</p><h2>Information We Collect</h2><p>We access basic Instagram account information including username and messages, solely to provide automated messaging services.</p><h2>How We Use Your Information</h2><p>We process your information only to respond to user inquiries and provide support through our Services.</p><h2>Data Sharing</h2><p>We do not sell or share your personal information with third parties except as required by law.</p><h2>Contact</h2><p>Questions? Email us at <a href='mailto:iatamlabsllc@gmail.com'>iatamlabsllc@gmail.com</a></p></body></html>`;\nreturn [{ json: { response: html } }];"
