    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.revolicord.com/admin/leads/{{ $('Get Subscriber').item.json.subscriber_id }}/stage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer c37a1bb5741c19a484203b7f691fd445e92410e46d934c82c6170b5734acaa80"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"new_stage\": \"D\",\n    \"reason\": \"calendly_booked\",\n    \"evidence\": \"={{ 'Calendly invitee.created @ ' + $('Webhook').first().json.body.payload.scheduled_event.start_time + ' — ' + \n  $('Webhook').first().json.body.payload.scheduled_event.uri }}\"\n  }\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        464,
        -176
      ],
      "id": "8aaaf0d3-2ccd-47dd-aec2-0a5b0cecb116",
      "name": "Set Stage D",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const p = $('Webhook').first().json.body.payload;\n  const ev = p.scheduled_event || {};\n  const booking = {\n    event_uri: ev.uri || p.event || null,\n    invitee_uri: p.uri || null,\n    start_time: ev.start_time || null,\n    end_time: ev.end_time || null,\n    join_url: (ev.location && ev.location.join_url) || null,\n    timezone: p.timezone || null,\n    reschedule_url: p.reschedule_url || null,\n    cancel_url: p.cancel_url || null,\n    invitee_email: p.email || null,\n    booked_at: new Date().toISOString(),\n  };\n  return [{ json: { ...$json, bookingJson: JSON.stringify({ booking }) } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -176
      ],
      "id": "0cc6011a-fbe4-4641-b089-820ecf588b4c",
      "name": "Build Booking JSON"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "  UPDATE api.subscribers\n  SET metadata = COALESCE(metadata, '{}'::jsonb) || $2::jsonb\n  WHERE id = $1::uuid\n",
        "options": {
          "queryReplacement": "={{ $('Get Subscriber').first().json.subscriber_id }}, {{ $json.bookingJson }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        -176
      ],
      "id": "5a100c7a-a763-4417-be3e-24d057f8ceb0",
      "name": "Persist Bookings",
      "credentials": {
        "postgres": {
          "id": "xBbNbntvO0xJs5HM",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const p = $('Webhook').first().json.body.payload;\n  const start = (p.scheduled_event || {}).start_time;\n  const tz = p.timezone || 'America/Santo_Domingo';\n  const when = start\n    ? new Intl.DateTimeFormat('es', {\n        weekday: 'long', day: 'numeric', month: 'long',\n        hour: '2-digit', minute: '2-digit', timeZone: tz,\n      }).format(new Date(start))\n    : 'la fecha acordada';\n  return [{ json: { ...$json, whenLocal: when } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        -176
      ],
      "id": "58d1e587-12d7-408c-93b2-40211913713d",
      "name": "Format Datetime"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.revolicord.com/admin/leads/{{ $('Get Subscriber').first().json.subscriber_id }}/system-event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer c37a1bb5741c19a484203b7f691fd445e92410e46d934c82c6170b5734acaa80"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"event_type\": \"booking_confirmed\",\n    \"detail\": \"={{ 'agendó la llamada para ' + $json.whenLocal }}\"\n  }\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1296,
        -176
      ],
      "id": "f181b54f-628e-49da-b1ad-be4c64941e01",
      "name": "System Event",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    s.id                              AS subscriber_id,\n    s.manychat_subscriber_id,         \n    s.tenant_id,\n    s.display_name,\n    ls.current_stage,\n    t.config->>'manychat_api_key'     AS mc_api_key\n  FROM api.subscribers s\n  JOIN api.tenants t ON t.id = s.tenant_id\n  LEFT JOIN api.lead_stages ls\n    ON ls.subscriber_id = s.id AND ls.tenant_id = s.tenant_id\n  WHERE s.id = $1::uuid\n",
        "options": {
          "queryReplacement": "={{ $('Webhook').first().json.body.payload.tracking.utm_content }},"
        }
      },
