{
  "name": "@dm-api/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@dm-api/db": "workspace:*",
    "@dm-api/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "11.1.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/sensible": "5.6.0",
    "@fastify/under-pressure": "8.5.2",
    "bullmq": "5.28.1",
    "drizzle-orm": "0.36.4",
    "fastify": "4.28.1",
    "ioredis": "5.4.1",
    "pino": "9.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/supertest": "6.0.2",
    "pino-pretty": "11.3.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
