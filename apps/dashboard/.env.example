# Postgres (mismo que la API Fastify)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/n8n

# Auth del panel (SEPARADO del SPA admin)
PANEL_PASSWORD=changeme-please
PANEL_JWT_SECRET=replace-with-openssl-rand-hex-32

# Proxy admin → API Fastify (/settings).
# ADMIN_JWT_SECRET DEBE ser el mismo valor que el del servicio api (re-firma el JWT que el API verifica).
ADMIN_JWT_SECRET=replace-with-same-secret-as-api
# Base del API interno. En prod docker-stack inyecta http://n8n_api:3000; en dev local apunta al pnpm dev:api.
INTERNAL_API_URL=http://127.0.0.1:3000
